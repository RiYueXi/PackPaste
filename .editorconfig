root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{csproj,manifest,config,json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
